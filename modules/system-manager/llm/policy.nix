{ config, lib, ... }:

let
  cfg = config.llm;
  class = name: timeout: use: {
    model = cfg.models.${name}.id;
    inherit (cfg.models.${name}) context;
    timeout_min = timeout;
    inherit use;
  };
in
{
  config = lib.mkIf cfg.enable {
    # Model choice for agent jobs, read by the orchestrator (ssh coolermaster cat
    # /etc/llm-policy.json). Owner decisions 2026-11-19: 7.1 b, 7.2 b, 2.1 a, 10.1 a.
    # Values from coding-model-bench docs/dev/results-local-16gb.md, section
    # "Using it"; change them there, then here.
    environment.etc."llm-policy.json".text = builtins.toJSON {
      _doc = "Model choice for agent jobs. Generated by nix-darwin-config modules/system-manager/llm/policy.nix.";
      version = 1;
      defaults = {
        worker = "cloud";
        bench = "local";
        private = "local";
      };
      classes = {
        cloud = class "cloud" 25 "Orchestrator worker (default), large changes across packages";
        cloud-fallback = class "cloud-fallback" 25 "Only by owner/orchestrator: cloud model down or repeatedly failing";
        local = class "local" 25 "Bench, private data; bugfix, feature in one package, config/policy (t1-t4)";
        local-128k = class "local-128k" 60 "Only on request: logic change across packages (t5-like)";
      };
      gpu = {
        lock = cfg.gpuLock;
        wait_min = 90;
        status = "llm-gpu status";
        busy_before_start = "Worker with a local class: check 'llm-gpu status' first; busy -> choose cloud unless the data is private (then deferred).";
      };
      deferred = {
        exit_code = 75;
        fallback = "none";
        when = [
          "GPU lock not free after wait_min (llm-gpu: exit 75)"
          "opencode timeout (timeout_min of the class)"
          "two empty replies in a row"
        ];
        action = "Job ends as deferred (exit 75), no automatic switch to another model; restart or another model only by the owner or the orchestrator before the start.";
      };
    };
  };
}
