#!/bin/bash
# oc-outbox [<repo>] [--days N]   list the sandbox agents' results
# oc-outbox open <file>           view a file offline in the browser
#
# Runs as @ownerUser@. Lists mockups, screenshots and reports (html, png, svg, md)
# that are new or changed in the clones under @agentDir@/<repo> (git status).
#
# `open` starts a separate Chromium profile without network: all requests go to
# a dead proxy, DNS is switched off. A page written by the agent therefore
# cannot send anything outside (e.g. repo contents via an image URL), which
# would otherwise be a way out of the sandbox. External fonts and CDN scripts
# do not load for that reason; this is intended.
#
# Publish (e.g. as a claude.ai artifact) only after review, outside the
# sandbox.
set -euo pipefail

readonly SRV=@agentDir@
readonly REPOS=(@repos@)

die() { echo "oc-outbox: $*" >&2; exit 1; }

if [[ ${1:-} == open ]]; then
  f=$(realpath -e -- "${2:?file missing}") || die "file not found: $2"
  [[ $f == "$SRV"/* ]] || die "only files under $SRV"
  profile=$(mktemp -d /tmp/oc-outbox.XXXXXXXX)
  trap 'rm -rf "$profile"' EXIT
  chromium --user-data-dir="$profile" --no-first-run --no-default-browser-check \
    --disable-extensions --disable-sync --disable-background-networking \
    --proxy-server=http://127.0.0.1:9 --proxy-bypass-list='<-loopback>' \
    --host-resolver-rules='MAP * ~NOTFOUND' \
    --force-webrtc-ip-handling-policy=disable_non_proxied_udp \
    --new-window "file://$f" >/dev/null 2>&1
  exit 0
fi

days=7 repos=()
while (( $# )); do
  case $1 in
    --days) [[ ${2:-} =~ ^[0-9]{1,3}$ ]] || die "--days needs a number"; days=$2; shift ;;
    -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) [[ " ${REPOS[*]} " == *" $1 "* ]] || die "unknown repo: $1"; repos+=("$1") ;;
  esac
  shift
done
(( ${#repos[@]} )) || repos=("${REPOS[@]}")

# Only what is new or changed against the commit (git status), not the whole checkout.
for r in "${repos[@]}"; do
  d=$SRV/$r
  [[ -d $d/.git ]] || continue
  git -c safe.directory="$d" -C "$d" status --porcelain=v1 -z --untracked-files=all 2>/dev/null \
    | while IFS= read -r -d '' line; do
        f=${line:3}
        [[ $f =~ \.(html|png|svg|md)$ && -f $d/$f ]] || continue
        find "$d/$f" -mtime "-$days" -printf '%TY-%Tm-%Td %TH:%TM  %8s  %p\n'
      done
done | sort -r
