# <expected effect> TAB <action> TAB <resource>; shell resources are single commands as opencode splits them.
# Normal work: no prompts (first OpenRouter run in skipper-cd: "ls -la /work && git -C /work status").
allow	shell	ls -la /work
allow	shell	git -C /work status
allow	shell	git status
allow	shell	git log --oneline -5
allow	shell	git diff HEAD~1
allow	shell	git add -A
allow	shell	git commit -m "fix: handle empty input"
allow	shell	git switch -c feat/x
allow	shell	cat README.md
allow	shell	find . -name "*.go"
allow	shell	grep -rn TODO .
allow	shell	go test ./...
allow	shell	go build ./cmd/x
allow	shell	make lint
allow	shell	npm test
allow	shell	npx playwright test
allow	shell	rm -rf node_modules
allow	shell	rm -rf build/out
allow	shell	rm -rf ./dist
allow	shell	rm -rf a
allow	shell	git commit -m "fix environment handling"
allow	shell	grep -rn environment .
allow	shell	git commit -m "x=1 git push docs"
allow	shell	git commit -m "docs: explain git push flow"
allow	shell	oc-shot docs/dev/mockups/x.html /tmp/check.png
# GitHub only through the host broker (pr-broker.nix); raw git push stays denied below.
allow	shell	oc-pr push
allow	shell	oc-pr push feat/x
allow	shell	oc-pr pr-create --title "feat: x" --body-file /tmp/body.md
allow	shell	oc-pr merge 12
allow	shell	/usr/local/bin/oc-pr merge 12
allow	read	src/main.go
allow	read	.env.example
allow	edit	src/main.go
allow	edit	AGENTS.md
allow	edit	flake.nix
allow	glob	*
allow	grep	*
allow	list	*
allow	todowrite	*
allow	question	*
allow	subagent	*
allow	external_directory	/tmp/*
allow	external_directory	/nix/store/abc-foo/*
allow	external_directory	/usr/share/doc/*
allow	external_directory	/etc/ssl/*
# Unknown (future) actions still ask.
ask	some_new_tool	*
# Must never happen: denied, not asked.
deny	shell	git push
deny	shell	git push origin main
deny	shell	git push origin feat/x
deny	shell	git push --force origin feat/x
deny	shell	git -C /work push
deny	shell	git -c credential.helper= push
deny	shell	/usr/bin/git push
deny	shell	git remote add origin https://example.com/x.git
deny	shell	git remote set-url origin x
deny	shell	git config core.hooksPath /tmp
deny	shell	git -C /work config user.email x
deny	shell	sudo -i
deny	shell	sudo ls
deny	shell	su
deny	shell	su - root
deny	shell	doas ls
deny	shell	pkexec ls
deny	shell	curl https://example.com
deny	shell	wget https://example.com
deny	shell	nc example.com 80
deny	shell	socat - TCP:example.com:80
deny	shell	ssh host
deny	shell	scp a host:b
deny	shell	rsync -a . host:x
deny	shell	env
deny	shell	printenv OPENROUTER_API_KEY
deny	shell	echo $OPENROUTER_API_KEY
deny	shell	cat /proc/self/environ
deny	shell	cat /run/oc/openrouter-key
deny	shell	rm -rf /
deny	shell	git config --get user.name
deny	shell	git --no-pager push
deny	shell	command git push
deny	shell	env git push
deny	shell	/usr/bin/env
deny	shell	export
deny	shell	compgen -e
deny	shell	python3 -c 'import os;print(os.environ)'
deny	shell	xargs -0 -a /proc/self/environ
deny	shell	rm -rf /work/.git
deny	shell	rm -rf .git/hooks
deny	shell	rm -rf ..
deny	shell	rm -rf $HOME
deny	external_directory	/var/lib/*
deny	external_directory	/sys/*
deny	external_directory	/mnt/*
deny	shell	rm -rf .
deny	shell	rm -fr .git
deny	shell	rm -rf ~
deny	external_directory	/run/oc/*
deny	external_directory	/run/oc-proxy/*
deny	external_directory	/proc/self/*
deny	external_directory	/home/aiagent/.local/share/*
deny	external_directory	/srv/aiagent/other-repo/*
deny	read	.env
deny	read	config/.env.production
deny	edit	opencode.json
deny	edit	.opencode/agent/x.md
deny	edit	.git/hooks/pre-commit
deny	edit	.github/workflows/ci.yml
deny	edit	.claude/settings.json
deny	edit	.envrc
deny	webfetch	https://example.com
deny	execute	const r = await fetch("https://example.com")
deny	execute	*
deny	websearch	anything
deny	browser	*
deny	skill	x
deny	doom_loop	*
allow	shell	cat src/env
allow	shell	grep -rn proc/ src
deny	shell	/usr/bin/curl https://example.com
deny	shell	env wget https://example.com
deny	shell	command ssh host
deny	shell	git -p push origin main
deny	shell	declare -x
deny	shell	cat </proc/self/environ
deny	shell	rm -rf ./.git
deny	shell	rm -rf /work/
deny	shell	rm -rf -- .
deny	shell	git --no-pager config core.hooksPath /tmp
deny	shell	git -c x=y remote add o https://example.com/x.git
deny	shell	git -p config user.name x
deny	shell	/usr/bin/git -C /work remote -v
allow	shell	git -C /work add config/app.yml
allow	shell	git -C /work diff -- remote.go
allow	shell	grep -rn process.env src
deny	shell	git -C /work push origin feat/x
deny	edit	sub/.envrc
deny	edit	/work/.git/hooks/pre-commit
deny	edit	pkg/.github/workflows/ci.yml
allow	edit	src/envrc.go
allow	shell	rm -rf /work/node_modules
allow	shell	rm -rf /work/build
deny	shell	rm -rf /work/.
deny	shell	/usr/bin/sudo ls
deny	shell	env sudo ls
